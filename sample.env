# Copy this file to .env. Never commit .env or API keys.
# Enable only the providers included in the first experiment.
EVISUFF_REPETITIONS=3

# Alibaba Cloud Model Studio / Qwen (OpenAI-compatible endpoint)
ENABLE_QWEN=false
QWEN_API_BASE=https://dashscope-us.aliyuncs.com/compatible-mode/v1
QWEN_API_KEY=REPLACE_WITH_QWEN_KEY
QWEN_MODEL=REPLACE_WITH_EXACT_QWEN_MODEL_ID
QWEN_INPUT_PRICE_USD_PER_MTOK=0
QWEN_OUTPUT_PRICE_USD_PER_MTOK=0

# Moonshot AI / Kimi (OpenAI-compatible endpoint)
ENABLE_KIMI=false
KIMI_API_BASE=https://api.moonshot.ai/v1
KIMI_API_KEY=REPLACE_WITH_KIMI_KEY
KIMI_MODEL=REPLACE_WITH_EXACT_KIMI_MODEL_ID
KIMI_INPUT_PRICE_USD_PER_MTOK=0
KIMI_OUTPUT_PRICE_USD_PER_MTOK=0

# OpenAI
ENABLE_OPENAI=false
OPENAI_API_BASE=https://api.openai.com/v1
OPENAI_API_KEY=REPLACE_WITH_OPENAI_KEY
OPENAI_MODEL=REPLACE_WITH_EXACT_OPENAI_MODEL_ID
OPENAI_INPUT_PRICE_USD_PER_MTOK=0
OPENAI_OUTPUT_PRICE_USD_PER_MTOK=0

# Anthropic native Messages API
ENABLE_ANTHROPIC=false
ANTHROPIC_API_BASE=https://api.anthropic.com/v1
ANTHROPIC_API_KEY=REPLACE_WITH_ANTHROPIC_KEY
ANTHROPIC_MODEL=REPLACE_WITH_EXACT_CLAUDE_MODEL_ID
ANTHROPIC_INPUT_PRICE_USD_PER_MTOK=0
ANTHROPIC_OUTPUT_PRICE_USD_PER_MTOK=0
